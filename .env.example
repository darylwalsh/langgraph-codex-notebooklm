# Copy to .env (git-ignored). mise loads it automatically via `_.file = ".env"`.

# --- Model provider keys -------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: only needed if you point a role at another provider (recommended
# for the judge, so it doesn't share the drafter's blind spots).
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- CourtListener (free token: courtlistener.com -> profile -> API) -------
COURTLISTENER_API_TOKEN=

# --- Per-agent models ("provider:model", passed to langchain init_chat_model)
S1983_MODEL_RESEARCH=anthropic:claude-sonnet-5-5
S1983_MODEL_PLAINTIFF=anthropic:claude-opus-5-5
S1983_MODEL_DEFENSE=anthropic:claude-opus-5-5
S1983_MODEL_JUDGE=anthropic:claude-opus-5-5
S1983_MODEL_DRAFTER=anthropic:claude-opus-5-5
# Agent 5 (verifier) is deterministic code: eyecite + CourtListener. No model.

# --- Optional tracing ------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=s1983-agents
